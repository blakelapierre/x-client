# Environment variables
PORT=3000

# Real X API (Bearer Token for app-only, or User Token for personal following)
TWITTER_BEARER_TOKEN=
# Optional: OAuth 2.0 user access token (for following list)
TWITTER_USER_TOKEN=
# Your own user ID (required with user token to fetch following)
MY_USER_ID=
# Fallback list of usernames to follow if no user token (comma-separated)
FOLLOWING_USERNAMES=elonmusk,naval,karpathy,paulg
